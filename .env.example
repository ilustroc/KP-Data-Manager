APP_NAME="KP Data Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql_control
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_USERNAME=kp_data_manager_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_TIMEZONE=+00:00
DB_BRONZE_DATABASE=kp_bronze
DB_SILVER_DATABASE=kp_silver
DB_CONTROL_DATABASE=kp_control
DB_GOLD_DATABASE=kp_gold
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=mysql_control
DB_QUEUE=default
# Debe superar ETL_JOB_TIMEOUT_SECONDS para evitar que otro worker reserve el mismo job.
DB_QUEUE_RETRY_AFTER=3720

ETL_ENABLED=true
ETL_PYTHON_BINARY=
ETL_WORKDIR=
# Use 0 únicamente si el proceso puede ejecutarse sin límite; ajuste también DB_QUEUE_RETRY_AFTER.
ETL_PROCESS_TIMEOUT_SECONDS=3600
# Debe superar ETL_PROCESS_TIMEOUT_SECONDS y ser menor que DB_QUEUE_RETRY_AFTER.
ETL_JOB_TIMEOUT_SECONDS=3660
ETL_QUEUE=etl

IMPORT_STORAGE_DISK=imports
# Vacío utiliza storage/app/private/import-inbox. Los archivos grandes deben colocarse allí por SFTP/SCP.
IMPORT_INBOX_PATH=
IMPORT_MAX_WEB_UPLOAD_MB=50
IMPORT_ALLOWED_EXTENSIONS=csv,xlsx

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="KP Invest"

GESTIONES_REPORT_RECIPIENTS=
GESTIONES_REPORT_SUBJECT="Reporte histórico de gestiones"
GESTIONES_REPORT_SCHEDULE_ENABLED=false
GESTIONES_REPORT_SCHEDULE_TIME=07:00
GESTIONES_REPORT_DRIVE_ENABLED=false
# Guarde el JSON fuera de public/, por ejemplo: storage/app/private/google/service-account.json
GOOGLE_DRIVE_REPORT_CREDENTIALS_PATH=
GOOGLE_DRIVE_REPORT_FOLDER_ID=
GOOGLE_DRIVE_REPORT_SHARED_DRIVE_ID=
GOOGLE_DRIVE_REPORT_FILENAME=historico_gestiones.xlsx
GOOGLE_DRIVE_REPORT_CHUNK_MB=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
