    "VEHICULOS": {"headers": ["DOCUMENTO", "NOMBRE COMPLETO", "CLASE", "COMPRA", "FABRICACION", "MARCA", "PLACA", "# TRANSFERENCIA"], "year_min": 1900, "year_max": 2100},
    "PROPIEDADES": {"headers": ["DOCUMENTO", "PARTIDA_REGISTRAL", "ZONA_REGISTRAL", "OFICINA"]}
  }
}
